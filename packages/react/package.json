{
    "name": "@aether-zone/kosmos",
    "version": "0.1.0",
    "private": false,
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./styles.css": "./dist/styles.css"
    },
    "scripts": {
        "build": "tsup && cpx \"src/styles.css\" dist",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@kosmos/tokens": "workspace:*",
        "react-icons": "^5.7.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "cpx2": "^9.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.0"
    }
}